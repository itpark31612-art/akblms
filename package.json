{
  "name": "ems-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Education Management System (EMS) - Enterprise Grade Monorepo Platform",
  "author": "Antigravity Architect",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@ems/backend",
    "dev:frontend": "npm run dev --workspace=@ems/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@ems/shared",
    "build:backend": "npm run build --workspace=@ems/backend",
    "build:frontend": "npm run build --workspace=@ems/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=@ems/backend",
    "test:frontend": "npm run test --workspace=@ems/frontend",
    "test:e2e": "npm run test:e2e --workspace=@ems/frontend",
    "db:generate": "npm run db:generate --workspace=@ems/backend",
    "db:migrate": "npm run db:migrate --workspace=@ems/backend",
    "db:seed": "npm run db:seed --workspace=@ems/backend",
    "db:studio": "npm run db:studio --workspace=@ems/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2"
  }
}
