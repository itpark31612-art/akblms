# ==============================================================================
# EDUCATION MANAGEMENT SYSTEM (EMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in root or specific apps/.env files before running the project:
# cp .env.example .env

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Education Management System"
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ems_db?schema=public

# Docker PostgreSQL configuration (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Run `openssl rand -base64 48` to generate secure secrets in production
JWT_ACCESS_SECRET=ems_access_token_super_secret_jwt_key_2026_xyz!@#
JWT_REFRESH_SECRET=ems_refresh_token_super_secret_jwt_key_2026_abc$%^
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=debug # debug, info, warn, error
LOG_FILE_PATH=./logs

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_TITLE="EMS - Education Management System"
